# Every empty value below is required: compose / the web app refuse to start without it.

# --- SRT (give these to whoever runs vMix / Wirecast) ---
# 32-64 random characters (MediaMTX accepts at most 79)
SRT_PASSPHRASE=
SRT_PORT=8890
# Public address shown in the UI help box (the encoder dials this)
SRT_PUBLIC_HOST=live.example.com
SRT_PUBLIC_PORT=8890
# An encoder that reconnects within this many minutes continues the same buffer
RECONNECT_MIN=10

# --- web UI login (12+ char password) ---
WEB_USER=editor
WEB_PASSWORD=
# 127.0.0.1 = only the reverse proxy on this host can reach it (see README)
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Portainer: web has no host port; NPM reaches it over management_default (see docker-compose.portainer.yml)

# --- MediaMTX control API, used only between the two containers (any random string) ---
MEDIAMTX_API_PASS=

# --- Wasabi (leave S3_ENDPOINT, S3_BUCKET and both keys empty = keep clips on the server only) ---
# Singapore: https://s3.ap-southeast-1.wasabisys.com (must match the bucket's region)
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=live-clips

# --- housekeeping ---
MIN_FREE_GB=20
LOCAL_CLIP_HOURS=24
CUT_WORKERS=2

# --- Wirecast relay (Wirecast has no latency setting; this listener sets it) ---
WIRECAST_PORT=8891
WIRECAST_LATENCY_MS=1000
WIRECAST_NAME=wirecast1
